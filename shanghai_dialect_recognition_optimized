function [X, y, paths, speakers, splits] = subsample_by_class(X, y, paths, speakers, splits, max_per_class, seed)
    if isinf(max_per_class)
        return;
    end
    rng(seed);
    idx_pos = find(y == 1);
    idx_neg = find(y == 0);
    n_pos = min(numel(idx_pos), max_per_class);
    n_neg = min(numel(idx_neg), max_per_class);
    idx_pos = idx_pos(randperm(numel(idx_pos), n_pos));
    idx_neg = idx_neg(randperm(numel(idx_neg), n_neg));
    idx = [idx_pos; idx_neg];
    idx = idx(randperm(numel(idx)));
    X = X(idx, :);
    y = y(idx);
    paths = paths(idx);
    speakers = speakers(idx);
    splits = splits(idx);
end

function [train_idx, val_idx, test_idx] = enforce_min_class_counts(labels, train_idx, val_idx, test_idx, min_pos, min_neg, seed)
    rng(seed);
    [train_idx, val_idx, test_idx] = ensure_split(train_idx, val_idx, test_idx, labels, min_pos, min_neg);
end

function [train_idx, val_idx, test_idx] = ensure_split(train_idx, val_idx, test_idx, labels, min_pos, min_neg)
    % If any split has too few positives/negatives, redo split by label (not speaker).
    splits = {train_idx, val_idx, test_idx};
    for i = 1:3
        mask = splits{i};
        if sum(mask) == 0
            [train_idx, val_idx, test_idx] = stratified_three_way(labels, 0.7, 0.15, 0.15);
            return;
        end
        if sum(labels(mask) == 1) < min_pos || sum(labels(mask) == 0) < min_neg
            [train_idx, val_idx, test_idx] = stratified_three_way(labels, 0.7, 0.15, 0.15);
            return;
        end
    end
end

function [train_idx, val_idx, test_idx] = stratified_three_way(labels, r_train, r_val, r_test)
    train_idx = false(size(labels));
    val_idx = false(size(labels));
    test_idx = false(size(labels));
    classes = unique(labels(:))';
    for c = classes
        idx = find(labels == c);
        idx = idx(randperm(numel(idx)));
        n = numel(idx);
        n_train = max(1, round(n * r_train));
        n_val = max(1, round(n * r_val));
        if n_train + n_val >= n
            n_train = max(1, n - 2);
            n_val = 1;
        end
        n_test = max(1, n - n_train - n_val);
        train_idx(idx(1:n_train)) = true;
        val_idx(idx(n_train + 1:n_train + n_val)) = true;
        test_idx(idx(n_train + n_val + 1:n_train + n_val + n_test)) = true;
    end
end

function audio = trim_silence(audio)
    if isempty(audio)
        return;
    end
    thr = 0.02 * max(abs(audio));
    idx = find(abs(audio) > thr);
    if isempty(idx)
        return;
    end
    audio = audio(idx(1):idx(end));
end

function feats = compute_mfcc_features(audio, fs, num_coeffs)
    coeffs = mfcc(audio, fs, 'NumCoeffs', num_coeffs);
    coeffs = coeffs(~any(isnan(coeffs), 2), :);
    if isempty(coeffs)
        feats = zeros(1, num_coeffs * 2);
        return;
    end
    feats = [mean(coeffs, 1), std(coeffs, 0, 1)];
end

