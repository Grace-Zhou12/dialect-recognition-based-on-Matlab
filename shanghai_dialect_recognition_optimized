            ax(i).Toolbar.Visible = 'on';
        catch
        end
        try
            enableDefaultInteractivity(ax(i));
        catch
        end
    end
    drawnow;
    try
        exportgraphics(fig, [base_path '.pdf'], 'ContentType', 'vector');
        exportgraphics(fig, [base_path '.png'], 'Resolution', 300);
    catch
        print(fig, [base_path '.pdf'], '-dpdf', '-painters');
        print(fig, [base_path '.png'], '-dpng', '-r300');
    end
end

function labels = short_feature_labels(feature_names)
    labels = cell(size(feature_names));
    for i = 1:numel(feature_names)
        switch feature_names{i}
            case 'low_freq_ratio'
                labels{i} = 'LF';
            case 'pitch_variance'
                labels{i} = 'PV';
            case 'zcr'
                labels{i} = 'ZCR';
            case 'energy_variance'
                labels{i} = 'EV';
            case 'spectral_centroid'
                labels{i} = 'SC';
            case 'spectral_flux'
                labels{i} = 'SF';
            otherwise
                labels{i} = feature_names{i};
        end
    end
end

function value = safe_metric(metrics, field_name)
    value = 0;
    if isstruct(metrics) && isfield(metrics, field_name)
        value = metrics.(field_name);
    end
    if isempty(value) || isnan(value)
        value = 0;
    end
end

function out = safe_char(value)
    try
        if ismissing(value)
            out = '';
            return;
        end
    catch
    end
    if isstring(value)
        if isempty(value) || (isscalar(value) && ismissing(value))
            out = '';
            return;
        end
        out = char(value);
        return;
    end
    if ischar(value)
        out = value;
        return;
    end
    out = char(string(value));
end

function ok = splits_are_usable(labels, tags, params)
    [train_idx, val_idx, test_idx] = split_from_tags(tags);
    ok = split_has_minimums(labels, train_idx, params.min_eval_pos, params.min_eval_neg) && ...
         split_has_minimums(labels, val_idx, params.min_eval_pos, params.min_eval_neg) && ...
         split_has_minimums(labels, test_idx, params.min_eval_pos, params.min_eval_neg);
end

function ok = split_has_minimums(labels, mask, min_pos, min_neg)
    ok = sum(mask) > 0 && sum(labels(mask) == 1) >= min_pos && sum(labels(mask) == 0) >= min_neg;
end

function cache = load_feature_cache(cache_path)
    cache = containers.Map('KeyType', 'char', 'ValueType', 'any');
    if ~exist(cache_path, 'file')
        return;
    end
    loaded = load(cache_path, 'feature_cache');
    if isfield(loaded, 'feature_cache') && isa(loaded.feature_cache, 'containers.Map')
        cache = loaded.feature_cache;
    end
end

function save_feature_cache(cache_path, cache)
    feature_cache = cache; %#ok<NASGU>
    save(cache_path, 'feature_cache', '-v7.3');
end

function [feature_vector, status, cache, hit] = get_cached_or_extract_feature(filename, params, cache)
    key = cache_key_for_file(filename, params);
    hit = false;
    if cache.isKey(key)
        entry = cache(key);
        feature_vector = entry.feature_vector;
        status = entry.status;
        hit = true;
        return;
    end
    [feature_vector, status] = extract_features_from_file(filename, params);
    cache(key) = struct('feature_vector', feature_vector, 'status', status);
end

function key = cache_key_for_file(filename, params)
    info = dir(filename);
    if isempty(info)
        key = sprintf('%s|missing|%d|%d', filename, params.use_mfcc, params.mfcc_coeffs);
        return;
    end
    key = sprintf('%s|%.12f|%d|%d|%d', filename, info.datenum, info.bytes, params.use_mfcc, params.mfcc_coeffs);
end

function out = ternary(cond, a, b)
    if cond
        out = a;
    else
        out = b;
    end
end
